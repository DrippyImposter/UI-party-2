-- ============================================================
-- Dropdown — label above, dropdown box below, no card background
-- ============================================================
local function createDropdown(body, name, options, default, callback)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 54)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 16)
    label.FontFace = FONT_MED
    label.TextSize = 13
    label.TextColor3 = Theme.TextPrimary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = name
    label.Parent = row

    local box = Instance.new("TextButton")
    box.Size = UDim2.new(1, 0, 0, 32)
    box.Position = UDim2.new(0, 0, 0, 22)
    box.BackgroundColor3 = Theme.Base
    box.AutoButtonColor = false
    box.FontFace = FONT_MED
    box.TextSize = 12
    box.TextColor3 = Theme.TextPrimary
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = row

    local boxPad = Instance.new("UIPadding")
    boxPad.PaddingLeft = UDim.new(0, 10)
    boxPad.Parent = box

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, RADIUS_CONTROL)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Theme.Border
    boxStroke.Thickness = 1
    -- Border, NOT the default Contextual: on a TextBox/TextButton/TextLabel,
    -- Contextual strokes the rendered glyphs rather than the object's edge, so
    -- the text itself gets a heavy outline (very obvious while typing).
    boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    boxStroke.Parent = box

    -- plain ASCII "v" — the "▾" (U+25BE) symbol isn't in Inter's rendered
    -- glyph set on Roblox either (same tofu-box issue as the old "✕" close
    -- icon), so a literal letter is used instead of a Geometric Shapes glyph.
    -- Rotating it 180° on open reads as "^" (pointing up) well enough.
    local chevron = Instance.new("TextLabel")
    chevron.BackgroundTransparency = 1
    chevron.Size = UDim2.fromOffset(20, 32)
    chevron.Position = UDim2.new(1, -26, 0, 0)
    chevron.FontFace = FONT_BOLD
    chevron.TextSize = 13
    chevron.TextColor3 = Theme.TextDim
    chevron.Text = "v"
    chevron.Rotation = 0
    chevron.Parent = box

    local column = row:FindFirstAncestorWhichIsA("ScrollingFrame")
    local overlay = getOverlay(row)

    -- ScrollingFrame (not a plain Frame): the menu's on-screen height gets
    -- capped to MAX_VISIBLE rows / whatever space is actually free, but option
    -- lists can run far longer than that (e.g. a 51-chunk picker) — the
    -- overflow has to stay reachable by scrolling *inside* the menu rather
    -- than being silently cut off with no way to get to it.
    --
    -- Parented into the ScreenGui-level overlay, not into `row`, and given its
    -- screen position from box.AbsolutePosition each frame while open (see
    -- reposition). That detachment is what lets it paint over other sections
    -- and past the window's own edge.
    local list = Instance.new("ScrollingFrame")
    list.Name = "DropdownMenu"
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.AnchorPoint = Vector2.new(0, 0)
    list.Position = UDim2.fromOffset(0, 0)
    list.Size = UDim2.fromOffset(0, 0)
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollBarThickness = 4
    list.ScrollBarImageColor3 = Theme.TextDim
    list.Visible = false
    list.ZIndex = 1001
    list.ClipsDescendants = true
    list.Parent = overlay or row -- `or row` only as a degraded fallback

    local listCorner = Instance.new("UICorner")
    listCorner.CornerRadius = UDim.new(0, RADIUS_CONTROL)
    listCorner.Parent = list

    local listStroke = Instance.new("UIStroke")
    listStroke.Color = Theme.Border
    listStroke.Thickness = 1
    listStroke.Parent = list

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = list

    local selected = default
    box.Text = "  " .. tostring(selected)

    local closeConn, followConn
    local isOpen = false
    local openUpward = false
    local menuWidth, menuHeight = 0, 0
    local OPEN_TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local CLOSE_TWEEN = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    local ROW_H = 28
    local LIST_PAD = 8
    local MENU_GAP = 4
    local MAX_VISIBLE = 5

    -- Decides how tall the menu may be and which way it opens. Measured against
    -- the overlay (i.e. the whole screen) rather than the window, because the
    -- menu is explicitly allowed to extend past the window's edge. If it won't
    -- fit below the box it flips above; if it fits neither way it takes the
    -- roomier side, and the options that don't fit stay reachable by scrolling
    -- inside the menu.
    local function measure()
        local wanted = math.min(#options, MAX_VISIBLE) * ROW_H + LIST_PAD
        local oPos, oSize = overlay.AbsolutePosition, overlay.AbsoluteSize
        local bPos, bSize = box.AbsolutePosition, box.AbsoluteSize

        menuWidth = bSize.X

        local roomBelow = (oPos.Y + oSize.Y) - (bPos.Y + bSize.Y) - MENU_GAP
        local roomAbove = (bPos.Y - oPos.Y) - MENU_GAP
        local floor = ROW_H + LIST_PAD -- never collapse below one usable row

        if wanted <= roomBelow then
            openUpward, menuHeight = false, wanted
        elseif roomAbove > roomBelow then
            openUpward, menuHeight = true, math.max(math.min(wanted, roomAbove), floor)
        else
            openUpward, menuHeight = false, math.max(math.min(wanted, roomBelow), floor)
        end
    end

    -- Anchored bottom-left when opening upward, so growing the height expands
    -- the menu away from the box instead of down over it.
    local function reposition()
        local oPos = overlay.AbsolutePosition
        local bPos, bSize = box.AbsolutePosition, box.AbsoluteSize
        local x = bPos.X - oPos.X

        if openUpward then
            list.AnchorPoint = Vector2.new(0, 1)
            list.Position = UDim2.fromOffset(x, (bPos.Y - oPos.Y) - MENU_GAP)
        else
            list.AnchorPoint = Vector2.new(0, 0)
            list.Position = UDim2.fromOffset(x, (bPos.Y + bSize.Y - oPos.Y) + MENU_GAP)
        end
    end

    -- Roblox has no "effectively visible" query — GuiObject.Visible is local, so
    -- a visible box inside a hidden tab body still reads as Visible. Walking the
    -- chain is what catches a tab switch, a minimise, or window:Hide().
    local function ancestorsVisible(gui)
        local node = gui
        while node and node:IsA("GuiObject") do
            if not node.Visible then return false end
            node = node.Parent
        end
        return true
    end

    -- The menu no longer rides along with its box automatically, so anything
    -- that takes the box away — scrolling it out of its column, switching tabs,
    -- hiding the window — would otherwise strand the menu floating on screen.
    local function boxOnScreen()
        if not box:IsDescendantOf(game) then return false end
        if not ancestorsVisible(box) then return false end
        if not column then return true end
        local cPos, cSize = column.AbsolutePosition, column.AbsoluteSize
        local bPos, bSize = box.AbsolutePosition, box.AbsoluteSize
        return (bPos.Y + bSize.Y) > cPos.Y and bPos.Y < (cPos.Y + cSize.Y)
    end

    -- Animated close: tween the height back to 0 (the menu visually retracts
    -- into the box, since `list` clips its own contents) and only flip Visible
    -- off once that tween actually finishes.
    local function closeList()
        if not isOpen then return end
        isOpen = false

        if closeConn then
            closeConn:Disconnect()
            closeConn = nil
        end
        if followConn then
            followConn:Disconnect()
            followConn = nil
        end

        TweenService:Create(chevron, CLOSE_TWEEN, {Rotation = 0}):Play()

        local closeTween = TweenService:Create(list, CLOSE_TWEEN, {Size = UDim2.fromOffset(menuWidth, 0)})
        closeTween.Completed:Connect(function()
            if not isOpen then
                list.Visible = false
            end
        end)
        closeTween:Play()
    end

    local function pointInside(gui, x, y)
        local p, s = gui.AbsolutePosition, gui.AbsoluteSize
        return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
    end

    local function openList()
        if not overlay then return end
        isOpen = true

        measure()
        reposition()

        list.Size = UDim2.fromOffset(menuWidth, 0)
        list.Visible = true

        TweenService:Create(list, OPEN_TWEEN, {Size = UDim2.fromOffset(menuWidth, menuHeight)}):Play()
        TweenService:Create(chevron, OPEN_TWEEN, {Rotation = 180}):Play()

        -- Keeps the detached menu glued to its box while the column scrolls or
        -- the window gets dragged, and drops it once the box leaves view.
        followConn = RunService.Heartbeat:Connect(function()
            if not isOpen then return end
            if not boxOnScreen() then
                closeList()
                return
            end
            reposition()
        end)

        closeConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local pos = input.Position
                task.defer(function()
                    if isOpen and not pointInside(list, pos.X, pos.Y) and not pointInside(box, pos.X, pos.Y) then
                        closeList()
                    end
                end)
            end
        end)
    end

    box.MouseButton1Click:Connect(function()
        if isOpen then closeList() else openList() end
    end)

    for i, option in ipairs(options) do
        local optionRow = Instance.new("TextButton")
        optionRow.Size = UDim2.new(1, 0, 0, 28)
        optionRow.LayoutOrder = i
        optionRow.BackgroundTransparency = 1
        optionRow.AutoButtonColor = false
        optionRow.FontFace = FONT_BODY
        optionRow.TextSize = 12
        optionRow.TextColor3 = Theme.TextPrimary
        optionRow.Text = "  " .. tostring(option)
        optionRow.TextXAlignment = Enum.TextXAlignment.Left
        optionRow.Parent = list

        optionRow.MouseEnter:Connect(function()
            optionRow.BackgroundTransparency = 0
            optionRow.BackgroundColor3 = Theme.SurfaceHover
        end)
        optionRow.MouseLeave:Connect(function()
            optionRow.BackgroundTransparency = 1
        end)

        optionRow.MouseButton1Click:Connect(function()
            selected = option
            box.Text = "  " .. tostring(selected)
            closeList()
            if callback then callback(selected) end
        end)
    end

    local api = {
        set = function(v)
            selected = v
            box.Text = "  " .. tostring(selected)
        end,
        get = function() return selected end,
        -- targets the label above the box, matching the old UiLibrary's
        -- dropdown setText (which overrides dropdownLabel, not the
        -- selector button's own text)
        setText = function(newText) label.Text = newText end,
    }
    -- old UiLibrary compat aliases (setOption/getOption) — see file header
    api.setOption = api.set
    api.getOption = api.get
    return api
end

