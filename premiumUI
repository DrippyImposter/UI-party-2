-- ============================================================
-- Config save/load — writefile/readfile based, JSON-encoded. Ported from
-- the old UiLibrary. Executor function names vary, so this probes the
-- common aliases (default global, syn.*, fluxus.*) rather than assuming
-- one; on an executor with none of these, every method below just
-- returns false instead of erroring.
-- ============================================================
local function getFs()
    local wf = writefile or (syn and syn.writefile) or (fluxus and fluxus.writefile)
    local rf = readfile or (syn and syn.readfile) or (fluxus and fluxus.readfile)
    local df = delfile or (syn and syn.delfile) or (fluxus and fluxus.delfile)
    local isf = isfile or (syn and syn.isfile) or (fluxus and fluxus.isfile)
    local lf = listfiles or (syn and syn.listfiles) or (fluxus and fluxus.listfiles)
    local mf = makefolder or (syn and syn.makefolder) or (fluxus and fluxus.makefolder)
    local isfld = isfolder or (syn and syn.isfolder) or (fluxus and fluxus.isfolder)
    return wf, rf, df, isf, lf, mf, isfld
end

local function ensureFolder(path)
    local _, _, _, _, _, mf, isfld = getFs()
    if not mf then return false end
    if isfld and isfld(path) then return true end
    return (pcall(mf, path))
end

local function basename(path)
    return tostring(path):match("[^/\\]+$") or tostring(path)
end

local function sanitizeName(name)
    name = tostring(name or "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("[^%w%-%_ ]", "")
    name = name:gsub("%s+", " ")
    return name
end

local function getConfigPath(folder, name)
    local clean = sanitizeName(name)
    if clean == "" then clean = "default" end
    return folder .. "/" .. clean .. ".json"
end

