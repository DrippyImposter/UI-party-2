-- ============================================================
-- Root helper
-- ============================================================
local function getGuiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local ok2, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and coreGui then
        local ok3 = pcall(function()
            local probe = Instance.new("Folder")
            probe.Parent = coreGui
            probe:Destroy()
        end)
        if ok3 then return coreGui end
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- ============================================================
-- Corner helpers — UICorner rounds all 4 corners of whatever it's on, so a
-- top/bottom bar gets its own UICorner plus a same-colour square "mask"
-- over the two corners we DON'T want rounded.
-- ============================================================
local function roundTop(frame, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = frame

    local mask = Instance.new("Frame")
    mask.BackgroundColor3 = frame.BackgroundColor3
    mask.BorderSizePixel = 0
    mask.ZIndex = 0
    mask.Size = UDim2.new(1, 0, 0, radius)
    mask.Position = UDim2.new(0, 0, 1, -radius)
    mask.Parent = frame
end

local function roundBottom(frame, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = frame

    local mask = Instance.new("Frame")
    mask.BackgroundColor3 = frame.BackgroundColor3
    mask.BorderSizePixel = 0
    mask.ZIndex = 0
    mask.Size = UDim2.new(1, 0, 0, radius)
    mask.Position = UDim2.new(0, 0, 0, 0)
    mask.Parent = frame
end

-- ============================================================
-- Dragging
-- ============================================================
local function makeDraggable(handle, target)
    local dragging = false
    local dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position

            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ============================================================
-- Pokéball icon — the one Pokémon Brick Bronze hint, kept fully grayscale
-- (no red) so it doesn't break the monochrome palette. Built from plain
-- circles/rectangles: no image assets, no font glyphs that might not exist
-- in a given Inter build.
-- ============================================================
local function createPokeball(size)
    local ball = Instance.new("Frame")
    ball.BackgroundColor3 = Theme.TextPrimary
    ball.BorderSizePixel = 0
    ball.Size = UDim2.fromOffset(size, size)

    local ballCorner = Instance.new("UICorner")
    ballCorner.CornerRadius = UDim.new(1, 0)
    ballCorner.Parent = ball

    local ballStroke = Instance.new("UIStroke")
    ballStroke.Color = Theme.Border
    ballStroke.Thickness = 1
    ballStroke.Parent = ball

    local band = Instance.new("Frame")
    band.AnchorPoint = Vector2.new(0, 0.5)
    band.Position = UDim2.new(0, 0, 0.5, 0)
    band.Size = UDim2.new(1, 0, 0, math.max(1, math.floor(size * 0.16)))
    band.BackgroundColor3 = Theme.Base
    band.BorderSizePixel = 0
    band.Parent = ball

    local buttonOuter = Instance.new("Frame")
    buttonOuter.AnchorPoint = Vector2.new(0.5, 0.5)
    buttonOuter.Position = UDim2.new(0.5, 0, 0.5, 0)
    buttonOuter.Size = UDim2.fromOffset(size * 0.42, size * 0.42)
    buttonOuter.BackgroundColor3 = Theme.Base
    buttonOuter.BorderSizePixel = 0
    buttonOuter.ZIndex = 2
    buttonOuter.Parent = ball

    local buttonOuterCorner = Instance.new("UICorner")
    buttonOuterCorner.CornerRadius = UDim.new(1, 0)
    buttonOuterCorner.Parent = buttonOuter

    local buttonInner = Instance.new("Frame")
    buttonInner.AnchorPoint = Vector2.new(0.5, 0.5)
    buttonInner.Position = UDim2.new(0.5, 0, 0.5, 0)
    buttonInner.Size = UDim2.fromOffset(size * 0.22, size * 0.22)
    buttonInner.BackgroundColor3 = Theme.TextPrimary
    buttonInner.BorderSizePixel = 0
    buttonInner.ZIndex = 3
    buttonInner.Parent = ball

    local buttonInnerCorner = Instance.new("UICorner")
    buttonInnerCorner.CornerRadius = UDim.new(1, 0)
    buttonInnerCorner.Parent = buttonInner

    return ball
end

-- ============================================================
-- Column — a scrollable half of a tab's body. Shared across every window
-- instance; takes no instance-specific state, just the parent/size/pos to
-- build into.
-- ============================================================
local function createColumn(parent, size, position)
    local column = Instance.new("ScrollingFrame")
    column.BackgroundTransparency = 1
    column.BorderSizePixel = 0
    column.Size = size
    column.Position = position
    column.ScrollBarThickness = 0 -- scrolling (wheel/drag) still works, just no visible track/thumb
    column.CanvasSize = UDim2.new(0, 0, 0, 0)
    -- open dropdown menus escape this by reparenting into the ScreenGui-level
    -- overlay (see getOverlay), so clipping can stay on unconditionally
    column.ClipsDescendants = true
    column.Parent = parent

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 16)
    padding.PaddingRight = UDim.new(0, 16)
    padding.PaddingTop = UDim.new(0, 16)
    padding.PaddingBottom = UDim.new(0, 16)
    padding.Parent = column

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = column

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        column.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 32)
    end)

    return column
end

-- ============================================================
-- Shared layout-order counter. A single ever-incrementing counter shared
-- across every window/section/row ever created in this session is fine —
-- Roblox's UIListLayout only compares LayoutOrder among direct siblings,
-- so unrelated absolute values from other windows/sections never collide.
-- ============================================================
local layoutOrderCounter = 0
local function nextOrder()
    layoutOrderCounter = layoutOrderCounter + 1
    return layoutOrderCounter
end

-- ============================================================
-- Overlay — one full-screen, non-clipping layer per ScreenGui that open
-- dropdown menus are reparented into.
--
-- A menu can never render correctly from inside the section/column tree:
-- the column, and the window itself, both set ClipsDescendants, so a menu
-- near either boundary is cut off no matter what its ZIndex is (clipping
-- ignores ZIndex entirely). On top of that, ZIndexBehavior.Sibling means a
-- menu's ZIndex only competes with its own siblings, so it can never paint
-- above a *different* section. Reparenting the menu to a sibling of
-- `window` with a high ZIndex escapes both constraints at once.
-- ============================================================
local OVERLAY_NAME = "PremiumUIOverlay"
local function getOverlay(descendant)
    local screenGui = descendant:FindFirstAncestorWhichIsA("ScreenGui")
    if not screenGui then return nil end

    local overlay = screenGui:FindFirstChild(OVERLAY_NAME)
    if not overlay then
        overlay = Instance.new("Frame")
        overlay.Name = OVERLAY_NAME
        overlay.BackgroundTransparency = 1
        overlay.BorderSizePixel = 0
        overlay.Position = UDim2.fromOffset(0, 0)
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.ClipsDescendants = false
        -- Active stays false so this transparent full-screen layer never
        -- swallows clicks meant for the window underneath it
        overlay.Active = false
        overlay.ZIndex = 1000 -- above `window`, the only sibling that matters
        overlay.Parent = screenGui
    end
    return overlay
end

-- ============================================================
-- Section — the boxed category container. One bordered box per category
-- (title sits as a "legend" overlapping the top border), with plain rows
-- stacked inside and NO background of their own. Sections nest: pass
-- another section's returned body in as `parent` to get a sub-box.
-- ============================================================
local TITLE_OVERLAP = 9  -- how far the legend title pokes above the box's top border
local DESC_Y          = 18
local DIVIDER_Y       = 42
local BODY_TOP        = 52
local BODY_SIDE_PAD   = 14
local BODY_BOTTOM_PAD = 14

local function createSection(parent, title, description)
    local wrapper = Instance.new("Frame")
    wrapper.BackgroundTransparency = 1
    wrapper.Size = UDim2.new(1, 0, 0, 0)
    wrapper.LayoutOrder = nextOrder()
    wrapper.Parent = parent

    local box = Instance.new("Frame")
    box.BackgroundColor3 = Theme.Surface
    box.BorderSizePixel = 0
    box.Size = UDim2.new(1, 0, 0, 0)
    box.Position = UDim2.new(0, 0, 0, TITLE_OVERLAP)
    box.Parent = wrapper

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, RADIUS_CARD)
    corner.Parent = box

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Border
    stroke.Thickness = 1
    stroke.Parent = box

    -- description line under the title — plain text, no chip/background,
    -- spans the full width like a subtitle rather than a floating pill
    local desc = Instance.new("TextLabel")
    desc.BackgroundTransparency = 1
    desc.Position = UDim2.new(0, BODY_SIDE_PAD, 0, DESC_Y)
    desc.Size = UDim2.new(1, -(BODY_SIDE_PAD * 2), 0, 16)
    desc.FontFace = FONT_BODY
    desc.TextSize = 12
    desc.TextColor3 = Theme.TextDim
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.TextTruncate = Enum.TextTruncate.AtEnd
    desc.Text = description or ""
    desc.Parent = box

    local divider = Instance.new("Frame")
    divider.BackgroundColor3 = Theme.Border
    divider.BorderSizePixel = 0
    divider.Size = UDim2.new(1, 0, 0, 1)
    divider.Position = UDim2.new(0, 0, 0, DIVIDER_Y)
    divider.Parent = box

    local body = Instance.new("Frame")
    body.BackgroundTransparency = 1
    body.Size = UDim2.new(1, -(BODY_SIDE_PAD * 2), 0, 0)
    body.Position = UDim2.new(0, BODY_SIDE_PAD, 0, BODY_TOP)
    body.Parent = box

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Padding = UDim.new(0, 10)
    bodyLayout.Parent = body

    local function resize()
        local bodyHeight = bodyLayout.AbsoluteContentSize.Y
        body.Size = UDim2.new(1, -(BODY_SIDE_PAD * 2), 0, bodyHeight)
        local boxHeight = BODY_TOP + bodyHeight + BODY_BOTTOM_PAD
        box.Size = UDim2.new(1, 0, 0, boxHeight)
        wrapper.Size = UDim2.new(1, 0, 0, boxHeight + TITLE_OVERLAP)
    end
    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
    resize()

    -- legend title: a sibling of `box` (not a child), so it sits centred on
    -- box's top border line without being pulled into any list layout.
    -- A small Pokéball sits before the text — the Pokemon Brick Bronze hint
    -- repeated on every section, not just once in the title bar.
    local titleGroup = Instance.new("Frame")
    titleGroup.AnchorPoint = Vector2.new(0, 0.5)
    titleGroup.Position = UDim2.new(0, 12, 0, TITLE_OVERLAP)
    titleGroup.AutomaticSize = Enum.AutomaticSize.X
    titleGroup.Size = UDim2.fromOffset(0, 18)
    titleGroup.BackgroundColor3 = Theme.Base
    titleGroup.ZIndex = 2
    titleGroup.Parent = wrapper

    local titleGroupPadding = Instance.new("UIPadding")
    titleGroupPadding.PaddingLeft = UDim.new(0, 6)
    titleGroupPadding.PaddingRight = UDim.new(0, 6)
    titleGroupPadding.Parent = titleGroup

    local titleGroupLayout = Instance.new("UIListLayout")
    titleGroupLayout.FillDirection = Enum.FillDirection.Horizontal
    titleGroupLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    titleGroupLayout.Padding = UDim.new(0, 5)
    titleGroupLayout.Parent = titleGroup

    local titleIcon = createPokeball(11)
    titleIcon.LayoutOrder = 1
    titleIcon.Parent = titleGroup

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.AutomaticSize = Enum.AutomaticSize.X
    titleLabel.Size = UDim2.fromOffset(0, 18)
    titleLabel.LayoutOrder = 2
    titleLabel.FontFace = FONT_BOLD
    titleLabel.TextSize = 13
    titleLabel.TextColor3 = Theme.TextPrimary
    titleLabel.Text = title
    titleLabel.Parent = titleGroup

    return body
end

-- ============================================================
-- Toggle — label + switch, single row, no background
-- ============================================================
local function createToggle(body, name, default, callback)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 26)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -54, 1, 0)
    label.FontFace = FONT_MED
    label.TextSize = 13
    label.TextColor3 = Theme.TextPrimary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = name
    label.Parent = row

    local track = Instance.new("Frame")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, 0, 0.5, 0)
    track.Size = UDim2.fromOffset(44, 22)
    track.BackgroundColor3 = default and Theme.ActiveTrack or Theme.TrackOff
    track.BorderSizePixel = 0
    track.Parent = row

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local hitArea = Instance.new("TextButton")
    hitArea.BackgroundTransparency = 1
    hitArea.Size = UDim2.new(1, 0, 1, 0)
    hitArea.Text = ""
    hitArea.Parent = track

    local state = default

    local function render(animated)
        local targetPos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        -- mid-gray when on (not near-white) so the white knob stays visible against it
        local targetColor = state and Theme.ActiveTrack or Theme.TrackOff
        if animated then
            TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
            TweenService:Create(track, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
        else
            knob.Position = targetPos
            track.BackgroundColor3 = targetColor
        end
    end
    render(false)

    hitArea.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if callback then callback(state) end
    end)

    local api = {
        set = function(v)
            state = v
            render(true)
        end,
        get = function() return state end,
        setText = function(newText) label.Text = newText end,
    }
    -- old UiLibrary compat aliases (setState/getState) — see file header
    api.setState = api.set
    api.getState = api.get
    return api
end

-- ============================================================
-- Action Toggle — looks like a toggle switch but holds no state: each
-- click flashes the track on, fires the callback once, then springs the
-- track back off after a beat. Old-library compat: {text=,callback=} in,
-- callback() takes no args, returns {setText=,element=}.
-- ============================================================
local function createActionToggle(body, config)
    config = config or {}
    local callback = config.callback or function() end

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 26)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -54, 1, 0)
    label.FontFace = FONT_MED
    label.TextSize = 13
    label.TextColor3 = Theme.TextPrimary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = config.text or "Action"
    label.Parent = row

    local track = Instance.new("Frame")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, 0, 0.5, 0)
    track.Size = UDim2.fromOffset(44, 22)
    track.BackgroundColor3 = Theme.TrackOff
    track.BorderSizePixel = 0
    track.Parent = row

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
