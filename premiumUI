-- Button Row — several buttons side by side in one row. Old-library
-- compat: {height=, buttons={{text=, callback=}, ...}} in, returns an
-- array of button API objects (same shape as CreateButton's return).
-- ============================================================
local function createButtonRow(body, config)
    config = config or {}
    local buttons = config.buttons or {}
    local count = math.max(1, #buttons)
    local GAP = 8

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, config.height or 36)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, GAP)
    layout.Parent = row

    local created = {}
    for i, btnConfig in ipairs(buttons) do
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = i
        btn.Size = UDim2.new(1 / count, -(GAP * (count - 1) / count), 1, 0)
        btn.BackgroundColor3 = Theme.Accent
        btn.AutoButtonColor = false
        btn.FontFace = FONT_BOLD
        btn.TextSize = 12
        btn.TextColor3 = Theme.Base
        btn.Text = btnConfig.text or "Button"
        btn.Parent = row

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, RADIUS_CONTROL)
        c.Parent = btn

        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Theme.AccentHover end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Theme.Accent end)

        local buttonAPI = {
            setText = function(newText) btn.Text = newText end,
            getText = function() return btn.Text end,
            element = btn,
        }

        btn.MouseButton1Click:Connect(function()
            if btnConfig.callback then btnConfig.callback(buttonAPI) end
        end)

        table.insert(created, buttonAPI)
    end

    return created
end

-- ============================================================
-- Move Buttons — the M1/M2/M3/M4 battle-move-select grid. Old-library
-- compat: {text=, default=, callback=} in, returns {setMove=, getMove=}.
-- ============================================================
local function createMoveButtons(body, config)
    config = config or {}
    local callback = config.callback
    local selectedMove = config.default or 1
    local GAP = 6

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 54)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 16)
    label.FontFace = FONT_MED
    label.TextSize = 13
    label.TextColor3 = Theme.TextPrimary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = config.text or "Select Move"
    label.Parent = row

    local buttonsRow = Instance.new("Frame")
    buttonsRow.BackgroundTransparency = 1
    buttonsRow.Position = UDim2.new(0, 0, 0, 22)
    buttonsRow.Size = UDim2.new(1, 0, 0, 32)
    buttonsRow.Parent = row

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, GAP)
    layout.Parent = buttonsRow

    local moveButtons = {}
    for i = 1, 4 do
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = i
        btn.Size = UDim2.new(0.25, -(GAP * 3 / 4), 1, 0)
        btn.AutoButtonColor = false
        btn.FontFace = FONT_BOLD
        btn.TextSize = 13
        btn.Text = "M" .. i
        btn.Parent = buttonsRow

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, RADIUS_CONTROL)
        c.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Theme.Border
        stroke.Thickness = 1
        -- Border mode: otherwise the M1-M4 labels render with outlined glyphs
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = btn

        moveButtons[i] = btn
    end

    local function render()
        for i, btn in ipairs(moveButtons) do
            local active = (i == selectedMove)
            btn.BackgroundColor3 = active and Theme.Accent or Theme.Base
            btn.TextColor3 = active and Theme.Base or Theme.TextPrimary
        end
    end
    render()

    for i, btn in ipairs(moveButtons) do
        btn.MouseButton1Click:Connect(function()
            selectedMove = i
            render()
            if callback then callback(i) end
        end)
    end

    return {
        setMove = function(move)
            selectedMove = move
            render()
        end,
        getMove = function() return selectedMove end,
    }
end

-- ============================================================
-- Type Switcher — a single button that cycles through a fixed list of
-- string options on click. Old-library compat: {types=, default=,
-- height=, callback=} in, callback(type, index) on click, returns
-- {setType=, getCurrentType=, setText=}.
-- ============================================================
local function createTypeSwitcher(body, config)
    config = config or {}
    local types = config.types or {"Option 1", "Option 2"}
    local callback = config.callback
    local currentIndex = config.default or 1

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, config.height or 40)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundColor3 = Theme.Base
    btn.AutoButtonColor = false
    btn.FontFace = FONT_BOLD
    btn.TextSize = 13
    btn.TextColor3 = Theme.TextPrimary
    btn.Text = types[currentIndex] or ""
    btn.Parent = row

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, RADIUS_CONTROL)
    c.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Border
    stroke.Thickness = 1
    -- Border mode, same reason as elsewhere: Contextual would outline the
    -- button's label glyphs instead of drawing its edge.
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn

    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Theme.SurfaceHover end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Theme.Base end)

    btn.MouseButton1Click:Connect(function()
        currentIndex = (currentIndex % #types) + 1
        btn.Text = types[currentIndex]
        if callback then callback(types[currentIndex], currentIndex) end
    end)

    return {
        setType = function(index)
            currentIndex = index
            btn.Text = types[currentIndex]
        end,
        getCurrentType = function()
            return types[currentIndex], currentIndex
        end,
        setText = function(newText)
            btn.Text = newText
        end,
    }
end

-- ============================================================
-- Container — the shared "thing you can add controls or nested sections
-- to" interface. Both a tab's column and a section's inner body use this
-- exact same metatable, just wrapping a different underlying Frame — that
-- symmetry is what makes CreateSection nesting work with no special case.
-- ============================================================
local Container = {}
Container.__index = Container

local function wrapContainer(bodyFrame)
    return setmetatable({_body = bodyFrame}, Container)
end

function Container:CreateSection(title, description)
    local sectionBody = createSection(self._body, title, description)
    return wrapContainer(sectionBody)
end

function Container:CreateToggle(name, default, callback)
    return createToggle(self._body, name, default, callback)
end

function Container:CreateActionToggle(config)
    return createActionToggle(self._body, config)
end

-- old-library name — same thing, kept for call-site compatibility
Container.addActionToggle = Container.CreateActionToggle

function Container:CreateButton(text, callback)
    return createButton(self._body, text, callback)
end

function Container:CreateTextButton(text, callback)
    return createTextButton(self._body, text, callback)
end

function Container:CreateSlider(name, min, max, default, callback)
    return createSlider(self._body, name, min, max, default, callback)
end

function Container:CreateDropdown(name, options, default, callback)
    return createDropdown(self._body, name, options, default, callback)
end

function Container:CreateTextbox(name, placeholder, callback)
    return createTextbox(self._body, name, placeholder, callback)
end

function Container:CreateLabel(text)
    return createLabel(self._body, text)
end

function Container:CreateInfoContainer(config)
    return createInfoContainer(self._body, config)
end

-- old-library name — same thing, kept for call-site compatibility
Container.addInfoContainer = Container.CreateInfoContainer

function Container:CreateButtonRow(config)
    return createButtonRow(self._body, config)
end

-- old-library name — same thing, kept for call-site compatibility
Container.addButtonRow = Container.CreateButtonRow

function Container:CreateMoveButtons(config)
    return createMoveButtons(self._body, config)
end

-- old-library name — same thing, kept for call-site compatibility
Container.addMoveButtons = Container.CreateMoveButtons

function Container:CreateTypeSwitcher(config)
    return createTypeSwitcher(self._body, config)
end

-- old-library name — same thing, kept for call-site compatibility
Container.addTypeSwitcher = Container.CreateTypeSwitcher

-- ============================================================
-- Decorative background flourish — a full grid of small diamonds (plain
-- rotated squares) that press inward toward the mouse and spring back out,
-- like a grid of springs. Diamonds need no per-cell clipping trick to draw
-- (the whole rotated square IS the shape), and the grid is a deterministic
-- fine mesh of thin outlines (not solid fills), faded smoothly by distance
-- from the bottom-left corner. Built fresh per window instance — each
-- window gets its own blocks and its own Heartbeat connection, cleaned up
-- in :Destroy().
-- ============================================================
local function buildFlourish(window, windowW, windowH)
    local blocks = {}
    local DIAMOND_SIDE = 16 -- uniform size — the gradient is carried by transparency alone

    local region = Instance.new("Frame")
    region.Name = "Flourish"
    region.BackgroundTransparency = 1
    region.Size = UDim2.new(1, 0, 1, 0)
    region.ZIndex = -1
    region.Parent = window

    local CELL = 20
    local cols = math.ceil(windowW / CELL)
    local rows = math.ceil(windowH / CELL)
    local maxDist = math.sqrt(windowW ^ 2 + windowH ^ 2)

    -- Outer edge margin stays excluded (diamonds there have nothing outside
    -- them to blend into — the window edge itself). The center-column gap
    -- is NOT excluded: with a dense continuous mesh, skipping it just cuts
    -- an ugly seam down the middle instead of avoiding a stray artifact.
    local EDGE_MARGIN = 24
    local topGapMin = TITLE_H + TAB_H
    local topGapMax = topGapMin + 16

    for row = 0, rows - 1 do
        for col = 0, cols - 1 do
            local x = col * CELL
            local y = row * CELL
            local inEdgeZone = x < EDGE_MARGIN or (x + CELL) > (windowW - EDGE_MARGIN)
            local inTopGap = (y + CELL) > topGapMin and y < topGapMax

            if not inEdgeZone and not inTopGap then
                local dx = x
                local dy = windowH - y
                local dist = math.sqrt(dx * dx + dy * dy) / maxDist -- 0 at bottom-left corner, 1 at far corner
                local strokeTransparency = 0.15 + dist * 1.6

                if strokeTransparency < 0.96 then
                    local cx = x + CELL / 2
                    local cy = y + CELL / 2

                    local block = Instance.new("Frame")
                    block.AnchorPoint = Vector2.new(0.5, 0.5)
                    block.Position = UDim2.fromOffset(cx, cy)
                    block.Size = UDim2.fromOffset(DIAMOND_SIDE, DIAMOND_SIDE)
                    block.Rotation = 45
                    block.BackgroundTransparency = 1 -- no fill at rest — outline only
                    block.BorderSizePixel = 0
                    block.Parent = region

                    local stroke = Instance.new("UIStroke")
                    stroke.Thickness = 1
                    stroke.Color = Theme.TextSecond
                    stroke.Transparency = math.clamp(strokeTransparency, 0.15, 0.96)
                    stroke.Parent = block

                    table.insert(blocks, {
                        frame = block,
                        stroke = stroke,
                        cx = cx,
                        cy = cy,
                        depth = 0,
                        velocity = 0,
                        baseStrokeTransparency = stroke.Transparency,
                    })
                end
            end
        end
    end

    -- Damped spring per block (not a flat tween) — quick to press in as the
    -- mouse approaches, with a bit of natural overshoot bouncing back out
    -- on release. At rest a block is just its faint outline (per the
    -- corner gradient above); pressing on it sharpens the outline toward
    -- fully solid AND brings the fill in, regardless of that block's base
    -- gradient value, so moving the mouse anywhere across the mesh "lights
    -- up" that patch, not just near the corner.
    local RADIUS = 90
    local STIFFNESS = 250
    local DAMPING = 20
    local SHRINK = 0.25
    local PRESSED_FILL = 0.35
    local PRESSED_STROKE = 0.05

    local connection = RunService.Heartbeat:Connect(function(dt)
        local mouse = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
        local winPos = window.AbsolutePosition

        for _, b in ipairs(blocks) do
            local bx = winPos.X + b.cx
            local by = winPos.Y + b.cy
            local dist = math.sqrt((mouse.X - bx) ^ 2 + (mouse.Y - by) ^ 2)

            local t = math.clamp(1 - dist / RADIUS, 0, 1)
            local target = t * t * (3 - 2 * t) -- smoothstep falloff, nicer than linear

            local accel = (target - b.depth) * STIFFNESS - b.velocity * DAMPING
            b.velocity += accel * dt
            b.depth += b.velocity * dt

            local d = math.clamp(b.depth, 0, 1.2) -- small overshoot allowed for the spring bounce
            local size = DIAMOND_SIDE * (1 - SHRINK * d)
            b.frame.Size = UDim2.fromOffset(size, size)
            b.frame.BackgroundTransparency = 1 - (1 - PRESSED_FILL) * d
            b.stroke.Transparency = b.baseStrokeTransparency - (b.baseStrokeTransparency - PRESSED_STROKE) * d
        end
    end)

    return region, connection
end

-- ============================================================
-- PremiumUI.new(config) — builds one independent window instance.
-- ============================================================
function PremiumUI.new(config)
    config = config or {}
    local WINDOW_W = config.width or 820
    local WINDOW_H = config.height or 560
    local windowName = config.name or "PremiumUIWindow"
    local configFolder = sanitizeName(config.configFolder or "")
    if configFolder == "" then configFolder = "PremiumUI_Configs" end
    local configGet = config.configGet
    local configSet = config.configSet

    -- Entrance splash: logo + tagline centred on screen, then the window opens
    -- and the logo shrinks into the title bar's icon slot and stays there.
    -- Pass splash = false to disable, or a table to override image/text/duration.
    local splashCfg = config.splash
    if splashCfg == nil then splashCfg = {} end
    local splashEnabled = splashCfg ~= false
    local splashTable = type(splashCfg) == "table" and splashCfg or {}
    -- Note: this is the *Image* (Texture) asset id. The Decal id that wraps it
    -- (96884987787159) renders blank through rbxassetid:// — see the loader below.
    local SPLASH_IMAGE = splashTable.image or "rbxassetid://82209945132862"
    local SPLASH_TEXT = splashTable.text or "The Klone Hub Experience"
    local SPLASH_TIME = splashTable.duration or 5

    local guiParent = getGuiParent()

    -- Destroy any previous run of this UI before making a new one. Without
    -- this, re-executing the script (extremely common while iterating on
    -- it) stacks a brand new window — and brand new dropdown lists — on
    -- top of whatever was already there instead of replacing it.
    for _, existing in ipairs(guiParent:GetChildren()) do
        if existing.Name == windowName then
            existing:Destroy()
        end
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = windowName
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 999
    screenGui.Parent = guiParent

    local window = Instance.new("Frame")
    window.Name = "Window"
    window.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
    window.Position = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2)
    window.BackgroundColor3 = Theme.Base
    window.BorderSizePixel = 0
    window.ClipsDescendants = true
    -- hidden from the very first frame so the window never flashes behind the
    -- splash; the splash sequence turns it back on when it opens
    window.Visible = not splashEnabled
    window.Parent = screenGui

    local windowCorner = Instance.new("UICorner")
    windowCorner.CornerRadius = UDim.new(0, RADIUS_WINDOW)
    windowCorner.Parent = window

    local windowStroke = Instance.new("UIStroke")
    windowStroke.Color = Theme.Border
    windowStroke.Thickness = 1
    windowStroke.Parent = window

    local flourish, flourishConnection = buildFlourish(window, WINDOW_W, WINDOW_H)

    -- ---- Title bar ----
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, TITLE_H)
    titleBar.BackgroundColor3 = Theme.Surface
    titleBar.BorderSizePixel = 0
    titleBar.Parent = window
    roundTop(titleBar, RADIUS_WINDOW)

    local titleBarLine = Instance.new("Frame")
    titleBarLine.Size = UDim2.new(1, 0, 0, 1)
    titleBarLine.Position = UDim2.new(0, 0, 1, -1)
    titleBarLine.BackgroundColor3 = Theme.Border
    titleBarLine.BorderSizePixel = 0
    titleBarLine.Parent = titleBar

    local titleIcon = createPokeball(18)
    titleIcon.Position = UDim2.new(0, 16, 0.5, -9)
    -- With the entrance animation on, the splash logo claims this slot when it
    -- lands, so the pokeball is never shown at all — leaving it visible just
    -- means the incoming logo visibly overlaps it for the whole flight.
    titleIcon.Visible = not splashEnabled
    titleIcon.Parent = titleBar

    local titleText = Instance.new("TextLabel")
    titleText.BackgroundTransparency = 1
    titleText.Size = UDim2.new(1, -186, 1, 0)
    titleText.Position = UDim2.new(0, 42, 0, 0)
    titleText.FontFace = FONT_BOLD
    titleText.TextSize = 14
    titleText.TextColor3 = Theme.TextPrimary
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.Text = config.title or "Premium UI"
    titleText.Parent = titleBar

    makeDraggable(titleBar, window)

    local controlsRow = Instance.new("Frame")
    controlsRow.BackgroundTransparency = 1
    controlsRow.Size = UDim2.new(0, 64, 1, 0)
    controlsRow.Position = UDim2.new(1, -72, 0, 0)
    controlsRow.Parent = titleBar

    local controlsLayout = Instance.new("UIListLayout")
    controlsLayout.FillDirection = Enum.FillDirection.Horizontal
    controlsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    controlsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    controlsLayout.Padding = UDim.new(0, 6)
    controlsLayout.Parent = controlsRow

    local function createWindowControlButton(glyph, hoverColor)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(28, 28)
        btn.BackgroundTransparency = 1
        btn.AutoButtonColor = false
        btn.FontFace = FONT_MED
        btn.TextSize = 14
        btn.TextColor3 = Theme.TextSecond
        btn.Text = glyph
        btn.Parent = controlsRow

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = btn

        btn.MouseEnter:Connect(function()
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = hoverColor or Theme.SurfaceHover
            btn.TextColor3 = Theme.TextPrimary
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundTransparency = 1
            btn.TextColor3 = Theme.TextSecond
        end)

        return btn
    end

    local minimizeBtn = createWindowControlButton("–")
    -- plain ASCII "X" — the "✕" (U+2715) symbol isn't in Inter's rendered
    -- glyph set on Roblox and shows as a tofu box; a literal letter always renders.
    local closeBtn = createWindowControlButton("X", Color3.fromRGB(210, 70, 70))

    -- ---- Tab strip ----
    local tabStrip = Instance.new("Frame")
    tabStrip.Name = "TabStrip"
    tabStrip.Size = UDim2.new(1, 0, 0, TAB_H)
    tabStrip.Position = UDim2.new(0, 0, 0, TITLE_H)
    tabStrip.BackgroundColor3 = Theme.Surface
    tabStrip.BorderSizePixel = 0
    tabStrip.Parent = window

    local tabStripLine = Instance.new("Frame")
    tabStripLine.Size = UDim2.new(1, 0, 0, 1)
    tabStripLine.Position = UDim2.new(0, 0, 1, -1)
    tabStripLine.BackgroundColor3 = Theme.Border
    tabStripLine.BorderSizePixel = 0
    tabStripLine.Parent = tabStrip

    local tabButtonsRow = Instance.new("Frame")
    tabButtonsRow.BackgroundTransparency = 1
    tabButtonsRow.Size = UDim2.new(1, -20, 1, 0)
    tabButtonsRow.Position = UDim2.new(0, 10, 0, 0)
    tabButtonsRow.Parent = tabStrip

    local tabButtonsLayout = Instance.new("UIListLayout")
    tabButtonsLayout.FillDirection = Enum.FillDirection.Horizontal
    tabButtonsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabButtonsLayout.Padding = UDim.new(0, 6)
    tabButtonsLayout.Parent = tabButtonsRow

    -- ---- Body container (holds one Frame per tab; only the active one is Visible) ----
    local bodyContainer = Instance.new("Frame")
    bodyContainer.Name = "BodyContainer"
    bodyContainer.BackgroundTransparency = 1
    bodyContainer.Size = UDim2.new(1, 0, 1, -(TITLE_H + TAB_H + FOOTER_H))
    bodyContainer.Position = UDim2.new(0, 0, 0, TITLE_H + TAB_H)
    bodyContainer.Parent = window

    -- ---- Tabs ----
    local tabs = {}

    local function selectTab(tab)
        for _, t in ipairs(tabs) do
            local active = (t == tab)
            t._tabBody.Visible = active
            t._tabButton.BackgroundColor3 = active and Theme.SurfaceHover or Theme.Surface
            t._tabButton.TextColor3 = active and Theme.TextPrimary or Theme.TextSecond
        end
    end

    local function addTab(name)
        local button = Instance.new("TextButton")
        button.AutomaticSize = Enum.AutomaticSize.X
        button.Size = UDim2.new(0, 0, 0, 30)
        button.BackgroundColor3 = Theme.Surface
        button.AutoButtonColor = false
        button.FontFace = FONT_MED
        button.TextSize = 12
        button.TextColor3 = Theme.TextSecond
        button.Text = name
        button.Parent = tabButtonsRow

        local buttonPad = Instance.new("UIPadding")
        buttonPad.PaddingLeft = UDim.new(0, 14)
        buttonPad.PaddingRight = UDim.new(0, 14)
        buttonPad.Parent = button

        local buttonConstraint = Instance.new("UISizeConstraint")
        buttonConstraint.MinSize = Vector2.new(70, 30)
        buttonConstraint.Parent = button

        local buttonCorner = Instance.new("UICorner")
        buttonCorner.CornerRadius = UDim.new(0, RADIUS_CONTROL)
        buttonCorner.Parent = button

        local tabBody = Instance.new("Frame")
        tabBody.BackgroundTransparency = 1
        tabBody.Size = UDim2.new(1, 0, 1, 0)
        tabBody.Visible = false
        tabBody.Parent = bodyContainer

        local leftColumn = createColumn(tabBody, UDim2.new(0.5, -(COLUMN_GAP / 2), 1, 0), UDim2.new(0, 0, 0, 0))
        local rightColumn = createColumn(tabBody, UDim2.new(0.5, -(COLUMN_GAP / 2), 1, 0), UDim2.new(0.5, COLUMN_GAP / 2, 0, 0))

        local tab = {
            Name = name,
            Left = wrapContainer(leftColumn),
            Right = wrapContainer(rightColumn),
            _tabButton = button,
            _tabBody = tabBody,
        }
        function tab:CreateSection(title, description)
            return self.Left:CreateSection(title, description)
        end

        table.insert(tabs, tab)

        button.MouseButton1Click:Connect(function()
            selectTab(tab)
        end)

        if #tabs == 1 then
            selectTab(tab)
        end

        return tab
    end

    -- ---- Footer ----
    local footer = Instance.new("Frame")
    footer.Name = "Footer"
    footer.Size = UDim2.new(1, 0, 0, FOOTER_H)
    footer.Position = UDim2.new(0, 0, 1, -FOOTER_H)
    footer.BackgroundColor3 = Theme.Surface
    footer.BorderSizePixel = 0
    footer.Parent = window
    roundBottom(footer, RADIUS_WINDOW)

    local footerLine = Instance.new("Frame")
    footerLine.Size = UDim2.new(1, 0, 0, 1)
    footerLine.BackgroundColor3 = Theme.Border
    footerLine.BorderSizePixel = 0
    footerLine.Parent = footer

    local statusText = Instance.new("TextLabel")
    statusText.BackgroundTransparency = 1
    statusText.Size = UDim2.new(1, -32, 1, 0)
    statusText.Position = UDim2.new(0, 14, 0, 0)
    statusText.FontFace = FONT_BODY
    statusText.TextSize = 11
    statusText.TextColor3 = Theme.TextSecond
    statusText.TextXAlignment = Enum.TextXAlignment.Left
    statusText.TextTruncate = Enum.TextTruncate.AtEnd
    statusText.Text = "Ready"
    statusText.Parent = footer

    local statusDot = Instance.new("Frame")
    statusDot.Size = UDim2.fromOffset(7, 7)
    statusDot.Position = UDim2.new(1, -14, 0.5, -3.5)
    statusDot.BackgroundColor3 = Theme.Success
    statusDot.BorderSizePixel = 0
    statusDot.Parent = footer

    local statusDotCorner = Instance.new("UICorner")
    statusDotCorner.CornerRadius = UDim.new(1, 0)
    statusDotCorner.Parent = statusDot

    -- ---- Minimize / close / toggle key ----
    local isMinimized = false

    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        tabStrip.Visible = not isMinimized
        bodyContainer.Visible = not isMinimized
        footer.Visible = not isMinimized
        flourish.Visible = not isMinimized
        local targetH = isMinimized and TITLE_H or WINDOW_H
        TweenService:Create(window, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Size = UDim2.fromOffset(WINDOW_W, targetH)}):Play()
    end)

    local toggleKeyConnection
    if config.toggleKey then
        toggleKeyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            -- Don't fire the hotkey while the user is typing. `gameProcessed` is
            -- true when the keystroke was already consumed by something else (a
            -- focused TextBox, the chat bar, ...), and GetFocusedTextBox is the
            -- direct "is a text field focused right now" check as a backstop.
            -- Without these, every letter is also a hotkey: with toggleKey = H,
            -- typing "Pikachu" hides the window mid-word.
            if gameProcessed then return end
            if UserInputService:GetFocusedTextBox() then return end

            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == config.toggleKey then
                screenGui.Enabled = not screenGui.Enabled
            end
        end)
    end

    local windowObj = {}

    function windowObj:addTab(name)
        return addTab(name)
    end

    function windowObj:SetTitle(text)
        titleText.Text = text
    end

    function windowObj:SetStatus(text)
        statusText.Text = text
    end

    function windowObj:Show()
        screenGui.Enabled = true
    end

    function windowObj:Hide()
        screenGui.Enabled = false
    end

    function windowObj:ToggleVisible()
        screenGui.Enabled = not screenGui.Enabled
    end

    function windowObj:SaveConfig(name)
        local wf = getFs()
        if not wf then return false end
        ensureFolder(configFolder)

        local payload = {}
        if type(configGet) == "function" then
            local ok, res = pcall(configGet)
            if ok and type(res) == "table" then payload = res end
        end

        local ok, data = pcall(function() return HttpService:JSONEncode(payload) end)
        if not ok then return false end

        return (pcall(wf, getConfigPath(configFolder, name), data))
    end

    function windowObj:LoadConfig(name)
        local _, rf, _, isf = getFs()
        if not rf then return false end

        local path = getConfigPath(configFolder, name)
        if isf and not isf(path) then return false end

        local ok, raw = pcall(rf, path)
        if not ok or not raw then return false end

        local ok2, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok2 or type(decoded) ~= "table" then return false end

        if type(configSet) == "function" then
            pcall(configSet, decoded)
            return true
        end
        return false
    end

    function windowObj:DeleteConfig(name)
        local _, _, df, isf = getFs()
        if not df then return false end

        local path = getConfigPath(configFolder, name)
        if isf and not isf(path) then return false end

        return (pcall(df, path))
    end

    function windowObj:GetConfigs()
        local _, _, _, _, lf = getFs()
        if not lf then return {} end
        ensureFolder(configFolder)

        local ok, files = pcall(lf, configFolder)
        if not ok or type(files) ~= "table" then return {} end

        local configs = {}
        for _, p in ipairs(files) do
            local nm = basename(p):gsub("%.json$", "")
            if nm ~= "" then table.insert(configs, nm) end
        end
        table.sort(configs)
        return configs
    end

    function windowObj:Destroy()
        if flourishConnection then
            flourishConnection:Disconnect()
        end
        if toggleKeyConnection then
            toggleKeyConnection:Disconnect()
        end
        screenGui:Destroy()
    end

    closeBtn.MouseButton1Click:Connect(function()
        windowObj:Destroy()
    end)

    -- ============================================================
    -- Entrance animation
    --
    -- Logo pops in centre-screen with the tagline rising in beneath it and a
    -- slow float while it holds. After `duration` the tagline fades, the window
    -- opens, and the logo flies into the title bar's icon slot — where it is
    -- reparented onto the title bar so it then drags around with the window.
    -- ============================================================
    if splashEnabled then
        local ICON = 18
        local LOGO_BIG = 190
        local LOGO_Y = -30 -- sits slightly above centre to leave room for the text

        local splashRoot = Instance.new("Frame")
        splashRoot.Name = "Splash"
        splashRoot.BackgroundTransparency = 1
        splashRoot.Position = UDim2.fromOffset(0, 0)
        splashRoot.Size = UDim2.fromScale(1, 1)
        splashRoot.ClipsDescendants = false
        splashRoot.Active = false -- never swallow clicks
        splashRoot.ZIndex = 2000  -- above the dropdown overlay (1000)
        splashRoot.Parent = screenGui

        local logo = Instance.new("ImageLabel")
        logo.Name = "Logo"
        logo.BackgroundTransparency = 1
        logo.Image = SPLASH_IMAGE
        logo.ScaleType = Enum.ScaleType.Fit -- never distort, whatever the source ratio
        logo.AnchorPoint = Vector2.new(0.5, 0.5)
        logo.Position = UDim2.new(0.5, 0, 0.5, LOGO_Y)
        logo.Size = UDim2.fromOffset(LOGO_BIG * 0.6, LOGO_BIG * 0.6)
        logo.ImageTransparency = 1
        logo.ZIndex = 2001
        logo.Parent = splashRoot

        -- Shown only if the image never loads, so the splash degrades to a mark
        -- instead of an invisible gap. Parented to `logo` so it inherits every
        -- position/size tween automatically, including the flight to the corner.
        local logoFallback = Instance.new("TextLabel")
        logoFallback.Name = "LogoFallback"
        logoFallback.BackgroundTransparency = 1
        logoFallback.Size = UDim2.fromScale(1, 1)
        logoFallback.FontFace = FONT_BOLD
        logoFallback.TextScaled = true
        logoFallback.TextColor3 = Theme.TextPrimary
        logoFallback.Text = "K"
        logoFallback.Visible = false
        logoFallback.ZIndex = 2002
        logoFallback.Parent = logo

        -- Image loading is async and fails *silently* — a wrong-type or moderated
        -- asset just renders nothing, forever, with no error. PreloadAsync is what
        -- lets us tell "still loading" apart from "will never load".
        --
        -- The usual culprit: rbxassetid:// renders only *Image* assets, but an
        -- upload's public/library id is often the *Decal* that wraps the image —
        -- a different asset id, which renders blank. Rather than make the caller
        -- hunt down the inner Texture id in Studio, fall back to the thumbnail
        -- endpoint, which resolves ANY asset id (Decal or Image) to a rendered
        -- picture. 420x420 is one of its supported sizes and is plenty for a
        -- 190px splash.
        task.spawn(function()
            local contentProvider = game:GetService("ContentProvider")

            local function tryLoad(image)
                logo.Image = image
                pcall(function() contentProvider:PreloadAsync({logo}) end)
                return logo.IsLoaded
            end

            if tryLoad(SPLASH_IMAGE) then return end

            local id = tostring(SPLASH_IMAGE):match("(%d+)")
            if id and tryLoad(("rbxthumb://type=Asset&id=%s&w=420&h=420"):format(id)) then
                return
            end

            logoFallback.Visible = true
            warn(("[PremiumUI] splash image would not load as either rbxassetid:// or " ..
                "rbxthumb:// (%s). Check the id is public and approved."):format(tostring(SPLASH_IMAGE)))
        end)

        local tagline = Instance.new("TextLabel")
        tagline.Name = "Tagline"
        tagline.BackgroundTransparency = 1
        tagline.AnchorPoint = Vector2.new(0.5, 0)
        tagline.Position = UDim2.new(0.5, 0, 0.5, 96)
        tagline.Size = UDim2.fromOffset(460, 30)
        tagline.FontFace = FONT_BOLD
        tagline.TextSize = 20
        tagline.TextColor3 = Theme.TextPrimary
        tagline.TextTransparency = 1
        tagline.Text = SPLASH_TEXT
        tagline.ZIndex = 2001
        tagline.Parent = splashRoot

        task.spawn(function()
            local POP = TweenInfo.new(0.75, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            local RISE = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

            TweenService:Create(logo, POP, {
                Size = UDim2.fromOffset(LOGO_BIG, LOGO_BIG),
                ImageTransparency = 0,
            }):Play()

            task.wait(0.35)
            TweenService:Create(tagline, RISE, {
                TextTransparency = 0,
                Position = UDim2.new(0.5, 0, 0.5, 80),
            }):Play()

            -- reversing, infinite tween — a slow breath rather than a static hold
            local float = TweenService:Create(
                logo,
                TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                {Position = UDim2.new(0.5, 0, 0.5, LOGO_Y - 12)}
            )
            float:Play()

            task.wait(math.max(0, SPLASH_TIME - 0.35))

            TweenService:Create(tagline, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                TextTransparency = 1,
            }):Play()
            task.wait(0.35)
            tagline:Destroy()

            float:Cancel() -- leaves the logo wherever it floated to; the fly-in picks up from there

            -- window opens: grow from 90% back to full, staying centred (the
            -- position offsets track the size so no AnchorPoint change is needed,
            -- which would otherwise fight makeDraggable's positioning)
            local OPEN = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            window.Size = UDim2.fromOffset(WINDOW_W * 0.9, WINDOW_H * 0.9)
            window.Position = UDim2.new(0.5, -WINDOW_W * 0.9 / 2, 0.5, -WINDOW_H * 0.9 / 2)
            window.Visible = true
            TweenService:Create(window, OPEN, {
                Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
                Position = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2),
            }):Play()

            -- wait for the open tween to settle before reading titleIcon's
            -- AbsolutePosition, otherwise the logo aims at a stale slot
            task.wait(0.5)

            -- Target derived from the title bar, not from titleIcon — that is
            -- hidden while the splash runs, and this keeps the landing spot
            -- correct regardless of the placeholder's state.
            local bar = titleBar.AbsolutePosition
            local root = splashRoot.AbsolutePosition
            local FLY = TweenInfo.new(0.85, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
            local fly = TweenService:Create(logo, FLY, {
                Position = UDim2.fromOffset(
                    bar.X - root.X + 16 + ICON / 2,
                    bar.Y - root.Y + titleBar.AbsoluteSize.Y / 2
                ),
                Size = UDim2.fromOffset(ICON, ICON),
            })

            fly.Completed:Connect(function()
                -- hand the logo to the title bar so it now moves with the window,
                -- and drop the placeholder pokeball entirely — the logo is the icon
                titleIcon:Destroy()
                logo.AnchorPoint = Vector2.new(0, 0)
                logo.Position = UDim2.new(0, 16, 0.5, -ICON / 2)
                logo.Size = UDim2.fromOffset(ICON, ICON)
                logo.ZIndex = 2
                logo.Parent = titleBar
                splashRoot:Destroy()
            end)
            fly:Play()
        end)
    end

    return windowObj
end

return PremiumUI
