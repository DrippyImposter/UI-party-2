-- ============================================================
-- Dropdown — label above, dropdown box below, no card background
-- ============================================================
local function createDropdown(body, name, options, default, callback)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 54)
    row.LayoutOrder = nextOrder()
    row.Parent = body

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 16)
    label.FontFace = FONT_MED
    label.TextSize = 13
    label.TextColor3 = Theme.TextPrimary
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = name
    label.Parent = row

    local box = Instance.new("TextButton")
    box.Size = UDim2.new(1, 0, 0, 32)
    box.Position = UDim2.new(0, 0, 0, 22)
    box.BackgroundColor3 = Theme.Base
    box.AutoButtonColor = false
    box.FontFace = FONT_MED
    box.TextSize = 12
    box.TextColor3 = Theme.TextPrimary
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = row

    local boxPad = Instance.new("UIPadding")
    boxPad.PaddingLeft = UDim.new(0, 10)
    boxPad.Parent = box

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, RADIUS_CONTROL)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Theme.Border
    boxStroke.Thickness = 1
    boxStroke.Parent = box

    -- plain ASCII "v" — the "▾" (U+25BE) symbol isn't in Inter's rendered
    -- glyph set on Roblox either (same tofu-box issue as the old "✕" close
    -- icon), so a literal letter is used instead of a Geometric Shapes glyph.
    -- Rotating it 180° on open reads as "^" (pointing up) well enough.
    local chevron = Instance.new("TextLabel")
    chevron.BackgroundTransparency = 1
    chevron.Size = UDim2.fromOffset(20, 32)
    chevron.Position = UDim2.new(1, -26, 0, 0)
    chevron.FontFace = FONT_BOLD
    chevron.TextSize = 13
    chevron.TextColor3 = Theme.TextDim
    chevron.Text = "v"
    chevron.Rotation = 0
    chevron.Parent = box

    -- Parented under `row` itself (not screenGui) and positioned purely
    -- relative to it — the same mechanism every other element in this UI
    -- already renders correctly with. `column` (the scrolling parent) has
    -- its clipping temporarily disabled while open so the list can still
    -- extend past the column's own bounds if needed (see openList/closeList).
    local column = row:FindFirstAncestorWhichIsA("ScrollingFrame")

    -- ScrollingFrame (not a plain Frame): the popup's own open height is
    -- capped at 5 rows below, but option lists can run much longer than
    -- that (e.g. a 51-chunk picker) — those extra rows need to stay
    -- reachable by scrolling *within the popup* rather than silently
    -- clipped off with no way to get to them.
    local list = Instance.new("ScrollingFrame")
    list.BackgroundColor3 = Theme.Surface
    list.BorderSizePixel = 0
    list.AnchorPoint = Vector2.new(0, 0)
    list.Position = UDim2.new(0, 0, 1, 4)
    list.Size = UDim2.new(1, 0, 0, 0)
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollBarThickness = 4
    list.ScrollBarImageColor3 = Theme.TextDim
    list.Visible = false
    list.ZIndex = 50
    list.ClipsDescendants = true
    list.Parent = row

    local listCorner = Instance.new("UICorner")
    listCorner.CornerRadius = UDim.new(0, RADIUS_CONTROL)
    listCorner.Parent = list

    local listStroke = Instance.new("UIStroke")
    listStroke.Color = Theme.Border
    listStroke.Thickness = 1
    listStroke.Parent = list

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = list

    local selected = default
    box.Text = "  " .. tostring(selected)

    local closeConn
    local isOpen = false
    local OPEN_TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local CLOSE_TWEEN = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    -- Animated close: tween the height back down to 0 (revealing less and
    -- less of the clipped list, i.e. it visually retracts upward into the
    -- box) and only flip Visible off + restore the column's clipping once
    -- that tween actually finishes.
    local function closeList()
        if not isOpen then return end
        isOpen = false

        if closeConn then
            closeConn:Disconnect()
            closeConn = nil
        end

        TweenService:Create(chevron, CLOSE_TWEEN, {Rotation = 0}):Play()

        local closeTween = TweenService:Create(list, CLOSE_TWEEN, {Size = UDim2.new(1, 0, 0, 0)})
        closeTween.Completed:Connect(function()
            if not isOpen then
                list.Visible = false
                row.ZIndex = 1
                adjustColumnClipping(column, -1)
            end
        end)
        closeTween:Play()
    end

    local function pointInside(gui, x, y)
        local p, s = gui.AbsolutePosition, gui.AbsoluteSize
        return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
    end

    -- Animated open: start at zero height right under the row (label +
    -- box, not just the box, so it can never land level with the button
    -- itself), Visible immediately, then tween the height open — since
    -- `list` already has ClipsDescendants on, growing the height is
    -- exactly a "drops down" reveal of the options, one row at a time
    -- from the top. Position/width are pure relative UDim2 (set once at
    -- creation), so only Size.Y ever needs to change here.
    local function openList()
        isOpen = true

        local targetHeight = math.min(#options, 5) * 28 + 8
        adjustColumnClipping(column, 1)

        -- boosts the whole row (not just `list`) above its sibling rows —
        -- Sibling ZIndex mode only compares elements under the same
        -- immediate parent, so `list`'s own high ZIndex alone would only
        -- beat `label`/`box`, not a later row in the same section
        row.ZIndex = 50

        list.Size = UDim2.new(1, 0, 0, 0)
        list.Visible = true

        TweenService:Create(list, OPEN_TWEEN, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
        TweenService:Create(chevron, OPEN_TWEEN, {Rotation = 180}):Play()

        closeConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local pos = input.Position
                task.defer(function()
                    if isOpen and not pointInside(list, pos.X, pos.Y) and not pointInside(box, pos.X, pos.Y) then
                        closeList()
                    end
                end)
            end
        end)
    end

    box.MouseButton1Click:Connect(function()
        if isOpen then closeList() else openList() end
    end)

    for i, option in ipairs(options) do
        local optionRow = Instance.new("TextButton")
        optionRow.Size = UDim2.new(1, 0, 0, 28)
        optionRow.LayoutOrder = i
        optionRow.BackgroundTransparency = 1
        optionRow.AutoButtonColor = false
        optionRow.FontFace = FONT_BODY
        optionRow.TextSize = 12
        optionRow.TextColor3 = Theme.TextPrimary
        optionRow.Text = "  " .. tostring(option)
        optionRow.TextXAlignment = Enum.TextXAlignment.Left
        optionRow.Parent = list

        optionRow.MouseEnter:Connect(function()
            optionRow.BackgroundTransparency = 0
            optionRow.BackgroundColor3 = Theme.SurfaceHover
        end)
        optionRow.MouseLeave:Connect(function()
            optionRow.BackgroundTransparency = 1
        end)

        optionRow.MouseButton1Click:Connect(function()
            selected = option
            box.Text = "  " .. tostring(selected)
            closeList()
            if callback then callback(selected) end
        end)
    end

    local api = {
        set = function(v)
            selected = v
            box.Text = "  " .. tostring(selected)
        end,
        get = function() return selected end,
        -- targets the label above the box, matching the old UiLibrary's
        -- dropdown setText (which overrides dropdownLabel, not the
        -- selector button's own text)
        setText = function(newText) label.Text = newText end,
    }
    -- old UiLibrary compat aliases (setOption/getOption) — see file header
    api.setOption = api.set
    api.getOption = api.get
    return api
end

